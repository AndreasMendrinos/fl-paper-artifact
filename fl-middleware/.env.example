APP_NAME=FL Resource Middleware
APP_VERSION=0.1.0
APP_ENV=development

IOTLAB_ENABLED=true
IOTLAB_MODE=mock
IOTLAB_API_URL=https://www.iot-lab.info/api

IOTLAB_USERNAME=
IOTLAB_PASSWORD=
IOTLAB_SITES=auto
IOTLAB_INCLUDE_NATIVE_DATA=false

CHAMELEON_ENABLED=true
CHAMELEON_MODE=mock
CHAMELEON_DISCOVERY_URL=https://api.chameleoncloud.org
# Use "auto" to discover sites dynamically.
# Alternatively: tacc,uc,ncar
CHAMELEON_SITES=auto

# Only sites matching one of these classes are selected automatically.
CHAMELEON_SITE_CLASSES=baremetal
#CHAMELEON_SITES=tacc,uc,ncar,nu,nrp
#CHAMELEON_CLUSTER=chameleon
CHAMELEON_CLUSTERS=auto
CHAMELEON_REQUEST_TIMEOUT_SECONDS=30
CHAMELEON_MAX_CONNECTIONS=10
CHAMELEON_VERIFY_SSL=true
CHAMELEON_INCLUDE_NATIVE_DATA=false

CHAMELEON_AUTH_ENABLED=true
CHAMELEON_AUTH_TYPE=
CHAMELEON_AUTH_URL=https://chi.tacc.chameleoncloud.org:5000/v3
CHAMELEON_APPLICATION_CREDENTIAL_ID=
CHAMELEON_APPLICATION_CREDENTIAL_SECRET=
CHAMELEON_REGION_NAME=
CHAMELEON_INTERFACE=public

CHAMELEON_KEY_NAME=
CHAMELEON_IMAGE_NAME=CC-Ubuntu22.04
CHAMELEON_NETWORK_NAME=sharednet1
CHAMELEON_SSH_USERNAME=cc

GRID5000_ENABLED=true
GRID5000_MODE=mock
GRID5000_API_URL=https://api.grid5000.fr/stable
GRID5000_USERNAME=
GRID5000_PASSWORD=

GRID5000_SITES=auto
GRID5000_INCLUDE_NATIVE_DATA=false
GRID5000_REQUEST_TIMEOUT_SECONDS=30
GRID5000_MAX_CONNECTIONS=10
GRID5000_VERIFY_SSL=true